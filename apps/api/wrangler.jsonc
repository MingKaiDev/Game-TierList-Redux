{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development (`pnpm dev`). Deploys always pick an env.
  "name": "gtl-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "local",
    "VERSION": "dev",
    "ALLOWED_ORIGINS": "http://localhost:5173",
  },
  // Local dev and tests use a local SQLite copy (.wrangler/state), never the remote DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtl-staging",
      "database_id": "ee9825df-0fb4-46ab-9802-5b6e23dfa0d8",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "gtl-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gtl-staging",
          "database_id": "ee9825df-0fb4-46ab-9802-5b6e23dfa0d8",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "VERSION": "dev",
        // PR previews of the web app live on <hash>.gtl-web.pages.dev
        "ALLOWED_ORIGINS": "http://localhost:5173,https://*.gtl-web.pages.dev",
      },
    },
    "production": {
      "name": "gtl-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gtl-prod",
          "database_id": "40f95f92-5c88-418c-b11a-9ead2162cd17",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "VERSION": "dev",
        "ALLOWED_ORIGINS": "https://gtl-web.pages.dev",
      },
    },
  },
}
